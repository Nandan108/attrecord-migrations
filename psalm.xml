<?xml version="1.0"?>
<psalm errorLevel="1" resolveFromConfigFile="true"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://getpsalm.org/schema/config" xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd" findUnusedBaselineEntry="true" findUnusedCode="true" phpVersion="8.1" allConstantsGlobal="true">
    <projectFiles>
        <directory name="src" />
        <directory name="tests" />
        <ignoreFiles>
            <directory name="vendor" />
        </ignoreFiles>
    </projectFiles>

    <issueHandlers>
        <!-- Test classes initialise properties in setUp(), not the constructor. -->
        <PropertyNotSetInConstructor>
            <errorLevel type="suppress">
                <directory name="tests" />
            </errorLevel>
        </PropertyNotSetInConstructor>
        <!-- #[\Override] requires PHP 8.3; suppress the nudge for test classes (mirrors attrecord). -->
        <MissingOverrideAttribute>
            <errorLevel type="suppress">
                <directory name="tests" />
            </errorLevel>
        </MissingOverrideAttribute>
        <!-- Test properties are accessed by PHPUnit; Psalm cannot see the callers. -->
        <PossiblyUnusedProperty>
            <errorLevel type="suppress">
                <directory name="tests" />
            </errorLevel>
        </PossiblyUnusedProperty>
        <!-- src: the public facade's surface is consumed by downstream packages, not this repo.
             tests: test methods live in shared Cases traits; PHPUnit is the (invisible) caller. -->
        <PossiblyUnusedMethod>
            <errorLevel type="suppress">
                <directory name="src" />
                <directory name="tests" />
            </errorLevel>
        </PossiblyUnusedMethod>
    </issueHandlers>
</psalm>
